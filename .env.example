# Copy to .env for local runs. .env is never committed.

# Model keys. Only the providers your agents use are needed.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Or send every model request through a LiteLLM proxy that holds the keys instead.
# AGENTS_GATEWAY_URL=http://127.0.0.1:4000
# AGENTS_GATEWAY_KEY=

# Bearer token for the endpoints that run agents. Without it they refuse every request.
AGENTS_API_TOKEN=

# Start the scheduler with the service (schedules are in UTC).
AGENTS_SCHEDULER=0

# Optional tenant tokens as a JSON object, each token must be unique.
# AGENTS_TENANT_TOKENS={"team-a":"replace-with-a-long-secret"}
